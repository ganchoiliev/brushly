# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules

# PDF proof harness output (scripts/pdf-proof.ts)
.pdf-proof/
.email-proof/
# keep your personal room photo out of git
real-wall.JPG

# onnxruntime-web wasm runtimes (copied from node_modules on postinstall)
/public/ort/

# test artifacts
/test-results/
/playwright-report/
**/test-results/
**/playwright-report/

# render-fidelity: real-engine baselines are billable + machine-specific — never
# commit them. The committed mock baseline (baseline.json) is deterministic.
src/lib/visualizer/fidelity/baseline.*.local.json
