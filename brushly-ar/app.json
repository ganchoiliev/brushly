{
  "expo": {
    "name": "Brushly AR",
    "slug": "brushly-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brushlyar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151515",
    "ios": {
      "bundleIdentifier": "uk.brushly.ar",
      "supportsTablet": false
    },
    "android": {
      "package": "uk.brushly.ar",
      "adaptiveIcon": {
        "backgroundColor": "#151515",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@reactvision/react-viro",
        {
          "android": { "xRMode": ["AR"] },
          "ios": {
            "cameraUsagePermission": "Brushly uses your camera to show paint colours on your walls in augmented reality.",
            "microphoneUsagePermission": "Brushly does not record audio; this permission is required by the AR engine.",
            "photosPermission": "Brushly saves your before/after renders to your photo library when you choose to download them.",
            "savephotosPermission": "Brushly saves your before/after renders to your photo library when you choose to download them.",
            "savePhotosPermission": "Brushly saves your before/after renders to your photo library when you choose to download them."
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#151515",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
